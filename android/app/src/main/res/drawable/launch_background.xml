<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal launch: solid color matching Flutter splash so no separate launcher is visible -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DDDEDF" />
        </shape>
    </item>
</layer-list>
